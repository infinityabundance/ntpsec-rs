{
  "__inputs": [],
  "__requires": [],
  "dashboard": {
    "__description": "NTPsec-rs daemon monitoring dashboard. Displays system clock discipline, per-peer synchronization statistics, and health metrics for all configured NTP peers.",
    "title": "NTPsec-rs Daemon",
    "description": "NTPsec-rs daemon monitoring dashboard. Displays system clock discipline, per-peer synchronization statistics, and health metrics for all configured NTP peers.",
    "tags": ["ntp", "ntpsec", "clock", "time-synchronization", "prometheus"],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "panels": [
      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "id": 1,
        "panels": [],
        "title": "System Overview",
        "type": "row"
      },
      {
        "id": 2,
        "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 },
        "type": "stat",
        "title": "Stratum",
        "description": "Current stratum of the system peer",
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 1, "color": "green" },
                { "value": 5, "color": "yellow" },
                { "value": 16, "color": "red" }
              ]
            },
            "mappings": [
              { "type": "value", "value": "16", "text": "Unsynchronized" }
            ],
            "min": 0,
            "max": 16
          },
          "overrides": []
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "ntp_stratum{source=\"ntpsec-rs\"}",
            "legendFormat": "Stratum",
            "refId": "A"
          }
        ]
      },
