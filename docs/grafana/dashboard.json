                { "value": 1, "color": "yellow" },
                { "value": 2, "color": "yellow" },
                { "value": 3, "color": "red" }
              ]
            },
            "mappings": [
              { "type": "value", "value": "0", "text": "No Warning" },
              { "type": "value", "value": "1", "text": "Add Leap" },
              { "type": "value", "value": "2", "text": "Remove Leap" },
              { "type": "value", "value": "3", "text": "Alarm" }
