FROM ubuntu:24.04

# Install runtime dependencies
RUN apt-get update -qq && apt-get install -y -qq \
    python3 \
    ntpsec \
    && rm -rf /var/lib/apt/lists/*

# Create directory for prebuilt test binary (mounted/baked in from CI)
RUN mkdir -p /build/tests

# Copy the test-runner script
COPY tests/docker/test-runner.sh /test-runner.sh
RUN chmod +x /test-runner.sh

CMD ["/test-runner.sh"]
