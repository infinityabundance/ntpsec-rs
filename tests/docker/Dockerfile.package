FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq xz-utils python3 && rm -rf /var/lib/apt/lists/*
COPY ntpsec-rs-d_*.deb ntpsec-rs-query_*.deb ntpsec-rs-dig_*.deb /tmp/
RUN dpkg -i /tmp/ntpsec-rs-d_*.deb /tmp/ntpsec-rs-query_*.deb /tmp/ntpsec-rs-dig_*.deb 2>&1 || true && \
    apt-get install -f -y -qq && \
    rm -f /tmp/*.deb
