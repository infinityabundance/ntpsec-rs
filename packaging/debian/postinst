#!/bin/sh
# postinst script for ntpsec-rs compatibility symlinks
#
# Creates compatibility symlinks so that existing NTPsec-aware scripts
# and tools work without modification.
#
# Requires: the target binary must exist at link time.

set -e

case "$1" in
    configure)
        # Daemon: cargo produces "ntpd-rs" from package ntpsec-rs-d
        if [ -x /usr/bin/ntpd-rs ]; then
            ln -sfn /usr/bin/ntpd-rs /usr/bin/ntpd
        elif [ -x /usr/sbin/ntpd-rs ]; then
            ln -sfn /usr/sbin/ntpd-rs /usr/sbin/ntpd
        else
            echo "ERROR: ntpd-rs binary not found" >&2
            exit 1
        fi

        # Query tool: cargo produces "ntpq-rs" from package ntpsec-rs-query
        if [ -x /usr/bin/ntpq-rs ]; then
            ln -sfn /usr/bin/ntpq-rs /usr/bin/ntpq
        else
            echo "ERROR: ntpq-rs binary not found" >&2
            exit 1
        fi

        # Diagnostics tool: cargo produces "ntpdig-rs" from package ntpsec-rs-dig
        if [ -x /usr/bin/ntpdig-rs ]; then
            ln -sfn /usr/bin/ntpdig-rs /usr/bin/ntpdig
        else
            echo "ERROR: ntpdig-rs binary not found" >&2
            exit 1
        fi

        # Remaining tools use package name as binary name
        for pair in "ntpsec-rs-mon:ntpmon" "ntpsec-rs-keygen:ntpkeygen" \
                    "ntpsec-rs-leapfetch:ntpleapfetch"; do
            src="${pair%%:*}"
            dst="${pair##*:}"
            if [ -x "/usr/bin/$src" ]; then
                ln -sfn "/usr/bin/$src" "/usr/bin/$dst"
            else
                echo "ERROR: $src binary not found" >&2
                exit 1
            fi
        done
        ;;
esac
