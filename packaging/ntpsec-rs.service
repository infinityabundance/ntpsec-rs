[Unit]
Description=ntpsec-rs NTP daemon
Documentation=man:ntpd-rs(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
EnvironmentFile=-/etc/default/ntpsec-rs
ExecStart=/usr/sbin/ntpd-rs -c /etc/ntp.conf -p /run/ntpd-rs.pid $DAEMON_OPTS
ExecReload=/bin/kill -HUP $MAINPID
PIDFile=/run/ntpd-rs.pid
Restart=on-failure
RestartSec=5
# Security hardening
CapabilityBoundingSet=CAP_SYS_TIME CAP_NET_BIND_SERVICE CAP_SYS_RESOURCE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
PrivateDevices=false
DevicePolicy=closed
# Time and NTP devices
DeviceAllow=/dev/pps0 rw
DeviceAllow=/dev/pps1 rw

[Install]
WantedBy=multi-user.target
